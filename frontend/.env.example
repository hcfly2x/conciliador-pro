# Use a URL absoluta no deploy da Vercel, por exemplo:
# NEXT_PUBLIC_API_URL=https://seu-backend.onrender.com/api/v1

# Em desenvolvimento, omita NEXT_PUBLIC_API_URL para usar o proxy do Next.js.
API_PROXY_TARGET=http://127.0.0.1:5061

# Habilite apenas no ambiente local quando quiser testar sem login.
NEXT_PUBLIC_AUTH_DISABLED=false
